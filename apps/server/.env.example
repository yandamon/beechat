# 复制为 .env 后按需修改；测试用 .env.test。Railway 会自动注入 PORT。
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# 本地 PostgreSQL：角色 beechat，库 beechat_dev（测试用 beechat_test）
DATABASE_URL=postgres://beechat:beechat_dev@localhost:5432/beechat_dev

# 注册时必须提供的邀请码，随时可换
INVITE_CODE=beechat-dev

# 演示账号一键登录，作品集访客用；不需要可设为 false
DEMO_ENABLED=true

# 图片存储：local 存到 UPLOADS_DIR（开发用，Railway 上重启会丢）；r2 存到 Cloudflare R2
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
# STORAGE_DRIVER=r2 时填写以下五项；R2_PUBLIC_URL 是桶的公开访问地址，不带末尾斜杠
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=beechat
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Web 推送（可选）：三项都填才启用。生成密钥：pnpm --filter @beechat/server exec web-push generate-vapid-keys
# VAPID_SUBJECT 是推送服务联系你的方式，mailto:you@example.com 或站点的 https 地址
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://beechat.example.com
