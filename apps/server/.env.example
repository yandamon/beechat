# 复制为 .env 后按需修改。Railway 会自动注入 PORT。
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# 以下变量在后续步骤启用，现在留空即可
# DATABASE_URL=postgres://postgres:<password>@localhost:5432/beechat_dev
# SESSION_COOKIE_SECRET=<至少 32 位随机字符串>
# INVITE_CODE=<注册邀请码>
# STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
